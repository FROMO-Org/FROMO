# Supabase project — Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FastAPI backend — keep as /api so the Vite dev-server proxy works.
# Do NOT change this to http://localhost:8000 or you will get CORS errors.
VITE_API_BASE_URL=

# OpenRouteService — optional, enables in-app directions.
# Free tier: 2000 requests/day. Get a key at openrouteservice.org/dev
VITE_ORS_API_KEY=
